# EditorConfig for TYPO3 Documentation
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 80

[*.rst]
indent_size = 3

[*.{yaml,yml}]
indent_size = 2

[Makefile]
indent_style = tab
